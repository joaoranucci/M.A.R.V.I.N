# Gere a chave: https://aistudio.google.com/apikey (projeto Free, sem billing)
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI
# Candidatos elegíveis conforme documentação; teste acesso/cota no seu projeto.
GEMINI_MODEL=gemini-3.5-flash-lite
# Voz masculina Faber pt-BR offline (primeira execução baixa ~63 MB)
# Alternativas online: pt-BR-AntonioNeural, pt-BR-FabioNeural (sem garantia)
MARVIN_VOICE=Piper-Faber-ptBR
MARVIN_SPEAK=true
# Escuta ao iniciar. Basta dizer 'Marvin'.
MARVIN_WAKE=true

# Se o microfone nao for detectado, veja LISTAR_MICROFONES.bat
MARVIN_MIC_DEVICE=
# Pode ajustar para 48000 se o dispositivo rejeitar 16000
MARVIN_MIC_RATE=auto

# Diagnostico se "Marvin" não ativar: aparece no rodape o texto ouvido
MARVIN_DEBUG_WAKE=false
# Opcional: palavras erradas usadas pelo Vosk para transcrever "Marvin"
MARVIN_WAKE_ALIASES=

# MARVIN v0.4: aplicativos instalados sao encontrados via Menu Iniciar/Registro.
# Acoes perigosas (fechar janela/bloquear PC) exigem confirmacao na interface.

# AGENTE VISUAL: SDK oficial UI-TARS. Instale Node.js 22 + INSTALAR_UI_TARS.bat.
# Necessita um modelo GUI/VLM compatível com as ações UI-TARS exposto via OpenAI-compatible API.
# Não confundir com a chave Gemini. Sem servidor de modelo, não há controle visual.
MARVIN_VISUAL=true
UI_TARS_BASE_URL=http://127.0.0.1:8080/v1
UI_TARS_MODEL=ui-tars-local
UI_TARS_API_KEY=local
UI_TARS_MAX_STEPS=8
# Enviar screenshots a endpoint externo exige opt-in explícito.
UI_TARS_ALLOW_REMOTE=false

# MARVIN v0.6: INSTALAR_SERVIDOR_IA.bat baixa o motor CUDA e pesos multimodais.
# O servidor roda somente em 127.0.0.1:8080 e nao gera cobrancas de API.

# MARVIN v0.6.3: acesso a projetos é limitado à pasta abaixo.
# Padrão: C:\Users\SEU_USUARIO\MARVIN_Projetos
# Para escolher outra pasta permitida, coloque um caminho local completo:
MARVIN_WORKSPACE_DIR=
# Ele pode criar/alterar arquivos de projetos, mas sobrescrever arquivos existentes
# exige sua autorização. Modificar o próprio MARVIN só após REVISAR CÓDIGO.

# v0.7: saída vazia usa o dispositivo padrão. Um nome selecionado requer sounddevice.
MARVIN_OUTPUT_DEVICE=
# Continuidade opcional de voz após resposta, 0..30 segundos; 0 exige nova ativação.
# Durante TTS use Esc/CANCELAR; interrupção por voz simultânea não é validada.
MARVIN_CONTINUITY_SECONDS=0
# Armazenamento alternativo (vazio usa data ao lado do aplicativo).
MARVIN_DATA_DIR=
# Preferências de áudio da interface ficam em data/preferences.json.
# Não há opção para ativar cobrança automaticamente.
